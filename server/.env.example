# Copiez ce fichier en .env et adaptez les valeurs.

# Local : mongodb://127.0.0.1:27017/dk_calendar
# MongoDB Atlas (prod) : mongodb+srv://<user>:<password>@<cluster>.mongodb.net/dk_calendar
MONGODB_URI=mongodb://127.0.0.1:27017/dk_calendar

# Secret utilisé pour signer les sessions (JWT). Générez une valeur aléatoire en production :
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=changez-moi-en-production

# Port d'écoute du serveur Express
PORT=4000

# Origine autorisée pour les requêtes du frontend (CORS + cookies)
CLIENT_ORIGIN=http://localhost:5173

NODE_ENV=development
