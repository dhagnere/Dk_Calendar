# Modèle de configuration pour docker-compose.prod.yml (déploiement sur les serveurs de la CUD).
# Copiez ce fichier en « .env » à la racine du dépôt sur le serveur, remplissez les valeurs réelles,
# et ne le committez JAMAIS (déjà ignoré par .gitignore comme tout fichier nommé .env).
#
# DATABASE_URL, PORT et NODE_ENV sont déjà fixés dans docker-compose.prod.yml (PostgreSQL interne
# au réseau Docker) : inutile de les redéfinir ici. Voir docs/DEPLOIEMENT-CUD.md pour la procédure
# complète pas à pas.

# Mot de passe du compte PostgreSQL « dk_calendar », choisi à la première installation. Générez une
# valeur aléatoire (lettres et chiffres uniquement, pour éviter d'avoir à l'échapper dans l'URL) :
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Attention : il n'est lu qu'à la création du volume de données. Le changer ensuite demande aussi
# un ALTER USER dans la base.
POSTGRES_PASSWORD=

# Secret de signature des sessions (JWT). Générez une vraie valeur aléatoire, différente de tout
# autre environnement (dev, démo…) :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# URL publique réelle de l'application sur l'infrastructure de la CUD (ex: https://calendrier.dunkerque-agglo.fr).
# CLIENT_ORIGIN et APP_URL doivent être identiques : le frontend est servi par ce même serveur.
CLIENT_ORIGIN=https://
APP_URL=https://

# --- Envoi d'emails (notification des administrateurs à chaque nouvelle demande d'accès) ---
# Laissez vide pour désactiver l'envoi réel : les emails seront alors seulement affichés dans les
# logs du conteneur (docker compose logs -f app) — à éviter en production réelle avec des
# utilisateurs externes, voir docs/DEPLOIEMENT-CUD.md § Sécurité.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@dunkerque-agglo.fr

# Optionnel : adresse fixe pour les notifications de demande d'accès, plutôt que tous les
# administrateurs actifs.
ADMIN_NOTIFICATION_EMAIL=

# --- Synchronisation de data/evenements.csv vers GitHub après chaque import CSV ---
# À laisser VIDE sur le serveur de production de la CUD : cette fonctionnalité pousse des commits
# vers le dépôt Git de développement, ce qui n'a pas de sens depuis l'environnement de prod (et
# éviterait d'y stocker un jeton avec droit d'écriture sur le dépôt). Gardez cette synchronisation
# activée uniquement sur l'environnement de dev/démo. Voir docs/DEPLOIEMENT-CUD.md § 10.
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BRANCH=
GITHUB_CHEMIN_EVENEMENTS=
