# Installe les workspaces locaux (client/, server/) en copiant leurs fichiers dans node_modules/
# plutôt qu'en créant un lien symbolique ("junction"). Sans ça, `npm install` échoue sous Windows
# sur certains postes avec l'erreur "EISDIR: illegal operation on a directory, symlink" — la
# création de jonctions y est bloquée (souvent par un antivirus d'entreprise), même avec le Mode
# développeur activé. Sans effet pratique ici : client et server ne s'importent jamais l'un
# l'autre comme des paquets, ils partagent juste l'outillage npm.
install-links=true
